# Copy to .env.local (gitignored) for local development.

# --- Anthropic --------------------------------------------------------------
# Workspace: Claudebook (wrkspc_01HBxmxGr7npSG8G28t8uGsb)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Printed by `npx tsx scripts/provision.ts` (phase 4).
ANTHROPIC_AGENT_ID=
ANTHROPIC_ENVIRONMENT_ID=

# --- Access control ---------------------------------------------------------
# Comma-separated. Admins can always sign in and manage the invite list in-app;
# everyone else is invited into Firestore's `allowedUsers` from that dialog.
# Empty means "no admins", which is recoverable — invited users still get in.
ADMIN_EMAILS=you@example.com

# --- Firebase public client config ------------------------------------------
# From `firebase apps:sdkconfig web --project claudebook-lm`.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=claudebook-lm.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=claudebook-lm
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Local Admin SDK --------------------------------------------------------
# On App Hosting the Admin SDK picks up ADC automatically. Locally, run
# `gcloud auth application-default login` once; no service-account JSON.
GOOGLE_CLOUD_PROJECT=claudebook-lm
