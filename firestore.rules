rules_version = '2';

// Default deny, with no exceptions.
//
// The browser never talks to Firestore in Claudebook — it holds a Firebase Auth
// session cookie and calls our own route handlers, which use the Admin SDK
// (Admin SDK access bypasses these rules). So there is no legitimate client
// read or write to allow, and anything that reaches this file is by definition
// something we did not intend.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
